generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model app_user {
  id           String         @id
  email        String?        @unique
  username     String?
  points       Int            @default(0)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  claim        claim[]
  listing      listing[]
  notification notification[]
  user_pref    user_pref?
}

model category {
  id      Int       @id @db.SmallInt
  name    String    @unique
  listing listing[]
}

model claim {
  id              String   @id
  listing_id      String
  claimer_user_id String
  status          String   @default("pending")
  message         String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  app_user        app_user @relation(fields: [claimer_user_id], references: [id])
  listing         listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)
}

model listing {
  id             String          @id
  finder_user_id String
  title          String
  description    String?
  category_id    Int?            @db.SmallInt
  status         String          @default("active")
  found_at       DateTime        @default(now()) @db.Timestamptz(6)
  expires_at     DateTime        @db.Timestamptz(6)
  lat            Float
  lng            Float
  place_name     String?
  manual_address String?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  image_url      String?
  claim          claim[]
  category       category?       @relation(fields: [category_id], references: [id])
  app_user       app_user        @relation(fields: [finder_user_id], references: [id])
  listing_photo  listing_photo[]
}

model listing_photo {
  id          String   @id
  listing_id  String
  url         String
  storage_key String?
  sort_order  Int      @default(0)
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)
  listing     listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)
}

model notification {
  id         String    @id
  user_id    String
  type       String
  channel    String
  payload    Json      @default("{}")
  status     String    @default("queued")
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime?
  app_user   app_user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_pref {
  user_id          String   @id
  notifications_on Boolean  @default(true)
  radius_meters    Int      @default(1000)
  category_filter  String[] @default([])
  dark_mode        Boolean  @default(true)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  app_user         app_user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
