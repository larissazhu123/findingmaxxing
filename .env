# Prisma — use the same Postgres as your active Supabase project (see pooler host in Dashboard → Database).
DATABASE_URL="postgresql://postgres.fhqkmumdnrxxyxzrqgeh:CS520Findmaxxing@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# Supabase JS — project fhqkmumdnrxxyxzrqgeh (jtcmjgoibipkopwsvwdk was removed / invalid).
# Two key formats are supported; src/lib/supabaseClient.ts and src/lib/auth.ts read
# the new `*_PUBLISHABLE_KEY` / `*_SECRET_KEY` first and fall back to the legacy
# `*_ANON_KEY` / `*_SERVICE_ROLE_KEY` JWTs. Use one set or the other, don't mix.
NEXT_PUBLIC_SUPABASE_URL=https://fhqkmumdnrxxyxzrqgeh.supabase.co

# New format (preferred). `sb_publishable_*` replaces the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Z9oqIeAcuPExCf64uShNRw__QXXfhXH
# `sb_secret_*` replaces the legacy service_role JWT. Server-only — never NEXT_PUBLIC_.
# Paste from Supabase → Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Legacy JWT names — only used if the *_PUBLISHABLE_KEY / *_SECRET_KEY above are blank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Dev-only fake session — when set, UserContext skips Supabase auth and presents
# the value below as the logged-in nickname. Leave UNSET in production.
NEXT_PUBLIC_DEV_USER_NICKNAME=Alex

# Google OAuth: Supabase → Authentication → Providers → Google. Redirect: http://localhost:3000/callback
